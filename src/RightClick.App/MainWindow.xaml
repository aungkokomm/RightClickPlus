<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RightClick_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:RightClick_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="RightClick+"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="RightClick+"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="28,12,28,28" Spacing="6" MaxWidth="660" HorizontalAlignment="Stretch">

                <!-- Hero header -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="RightClick+" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Tame your right-click menu and add genuinely useful actions." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="4">
                        <Button AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}" BorderThickness="0"
                                Click="Settings_Click">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                        </Button>
                        <Button AutomationProperties.Name="About" ToolTipService.ToolTip="About"
                                Background="{ThemeResource SubtleFillColorTransparentBrush}" BorderThickness="0"
                                Click="About_Click">
                            <FontIcon FontSize="16" Glyph="&#xE946;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Menu switch result -->
                <InfoBar Margin="0,0,0,4" IsClosable="True"
                         IsOpen="{x:Bind Menu.IsInfoOpen, Mode=TwoWay}"
                         Severity="{x:Bind Menu.InfoSeverity, Mode=OneWay}"
                         Title="{x:Bind Menu.InfoTitle, Mode=OneWay}"
                         Message="{x:Bind Menu.InfoMessage, Mode=OneWay}" />

                <!-- Context menu style -->
                <controls:SettingsCard Header="Context menu style"
                                       Description="{x:Bind Menu.CurrentModeText, Mode=OneWay}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE700;" />
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind Menu.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind VisWhenTrue(Menu.IsBusy), Mode=OneWay}" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind Menu.SwitchButtonText, Mode=OneWay}"
                                Command="{x:Bind Menu.SwitchMenuCommand}"
                                Visibility="{x:Bind VisWhenTrue(Menu.IsWindows11), Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Already classic on this Windows version"
                                   Visibility="{x:Bind VisWhenFalse(Menu.IsWindows11), Mode=OneWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <!-- Actions -->
                <TextBlock Margin="2,14,0,4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Right-click actions" />

                <controls:SettingsCard Header="Move to folder"
                                       Description="Moves each selected file into its own new folder named after the file.">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/file-to-folder.ico" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind Actions.FileToFolderEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="File note"
                                       Description="Creates a dated note next to a file and opens it. One file at a time.">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/file-notes.ico" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind Actions.FileNotesEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Copy file name(s)"
                                       Description="Adds a Copy submenu: name, name without extension, full path, quoted path.">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/copy-file-names.ico" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind Actions.CopyFileNamesEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="Folder color"
                                       Description="Right-click a folder to colour it so the ones that matter stand out.">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/folder-blue.ico" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind Actions.FolderColorEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <TextBlock Margin="2,8,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="On Windows 11, switch to the Classic menu above so these appear on the top-level right-click without 'Show more options'." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
