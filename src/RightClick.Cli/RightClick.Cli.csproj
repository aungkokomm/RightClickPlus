<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe so right-clicking never flashes a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RightClick.Cli</RootNamespace>
    <AssemblyName>RightClick.Cli</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WinForms gives a reliable clipboard + message box without a UI message loop. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x86;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RightClick.Core\RightClick.Core.csproj" />
    <ProjectReference Include="..\RightClick.Infrastructure\RightClick.Infrastructure.csproj" />
  </ItemGroup>
</Project>
